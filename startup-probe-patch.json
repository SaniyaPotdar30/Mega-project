{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "text-detector-app",
            "startupProbe": {
              "httpGet": {
                "path": "/health",
                "port": 5000
              },
              "periodSeconds": 10,
              "timeoutSeconds": 3,
              "failureThreshold": 36
            }
          }
        ]
      }
    }
  }
}
